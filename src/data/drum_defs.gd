## World pixels per sprite pixel: 2 for sprites still on the old 320 grid,
## 1 for sprites painted at full resolution ("hires": true).
static func pixel_scale(id: String) -> int:
	return 1 if DEFS[id].get("hires", false) else 2


static func get_def(id: String) -> Dictionary:
	return DEFS[id]


## Turns a digit-grid sprite into an Image using the def's ramp/accents.
static func make_image(id: String) -> Image:
	var d: Dictionary = DEFS[id]
	if d.get("hires", false):
		return DrumArt.paint(id)
	var ramp: Array = d.ramp
	var acc: Array = d.accent
	var key := {
		"o": Pal.INK,
		"1": Color(ramp[0]),
		"2": Color(ramp[1]),
		"3": Color(ramp[2]),
		"4": Color(ramp[3]),
		"5": Color(ramp[4]),
		"w": Pal.NIGHT1,
		"a": Color(acc[0]),
		"b": Color(acc[1]),
		"x": Pal.BONE,
	}
	return PixCanvas.grid(d.sprite, key)
